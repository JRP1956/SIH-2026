# VibeGuard — Docker environment variables
# Copy this file to .env and fill in the values.
#
#   cp .env.docker.example .env
#   docker compose up --build

# ── Database ─────────────────────────────────────────────────────────
# DATABASE_URL is overridden in docker-compose.yml to point at the 'db' service.
# Only set this if you're using an external database.
# DATABASE_URL=postgresql+psycopg://vibeguard:vibeguard@db:5432/vibeguard
POSTGRES_PASSWORD=vibeguard

# ── Auth ─────────────────────────────────────────────────────────────
# REQUIRED in production. Generate with:
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
JWT_SECRET=change-me-in-production

# ── GitHub OAuth ─────────────────────────────────────────────────────
# 1. Go to https://github.com/settings/developers → OAuth Apps → New
# 2. Set "Authorization callback URL" to:
#    https://<your-backend-domain>/auth/github/callback
# 3. Copy the Client ID and Client Secret here.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── OpenAI (optional — scans work without it, just no AI explanations) ──
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# ── URLs ─────────────────────────────────────────────────────────────
# The URL where your frontend is hosted (Vercel, or localhost:3000 for dev).
# Used for CORS and the OAuth redirect after login.
FRONTEND_URL=http://localhost:3000

# Set to true when frontend and backend are on different hosts (e.g. Vercel + Railway).
# This switches the session cookie to SameSite=None; Secure (requires HTTPS).
COOKIE_CROSS_SITE=false

# The URL the frontend uses to reach the backend API.
# Only needed if you're also running the frontend in Docker (--profile full).
NEXT_PUBLIC_API_URL=http://localhost:8000
