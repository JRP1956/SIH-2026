DATABASE_URL=postgresql+psycopg://vibeguard:vibeguard@localhost:5432/vibeguard
# Required off localhost; the app refuses to start with the built-in default.
# python -c 'import secrets; print(secrets.token_urlsafe(32))'
JWT_SECRET=change-me-in-production
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FRONTEND_URL=http://localhost:3000
# true when the frontend and backend are on different hosts. Sends the session
# cookie as SameSite=None; Secure, which browsers only accept over https.
COOKIE_CROSS_SITE=false
